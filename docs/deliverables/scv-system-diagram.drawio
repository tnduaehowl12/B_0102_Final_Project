rtex="1" parent="1"><mxGeometry x="2682.0" y="476.0" width="488.0" height="951.0" as="geometry"/></mxCell><mxCell id="c254" value="대기 (IDLE)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5D7C;fontColor=#17202A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2766.5" y="526.0" width="120.0" height="30.0" as="geometry"/></mxCell><mxCell id="c255" value="순찰 시작? (관제 웹)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="574.0" width="257.0" height="50.0" as="geometry"/></mxCell><mxCell id="c256" value="대기" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2985.0" y="585.8" width="173.0" height="26.5" as="geometry"/></mxCell><mxCell id="c259" value="S1 경로 생성: 구역별 왕복 + 설비 지점&lt;br&gt;(회피 구역 제외, D3)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="642.0" width="257.0" height="41.0" as="geometry"/></mxCell><mxCell id="c261" value="작업 목록: SURVEY · FACILITY · DOCK" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="701.0" width="257.0" height="26.5" as="geometry"/></mxCell><mxCell id="c263" value="배정 (D4): 같은 기능 · A 1차 순찰 · B&lt;br&gt;재검증 + 남은 구역" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="745.5" width="257.0" height="41.0" as="geometry"/></mxCell><mxCell id="c265" value="execute_task 전송 · 진행 감시 (status 1&lt;br&gt;Hz)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="804.5" width="257.0" height="41.0" as="geometry"/></mxCell><mxCell id="c267" value="후보 수신?" styl