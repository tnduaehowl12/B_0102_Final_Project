6.5" as="geometry"/></mxCell><mxCell id="c283" value="비상정지 버튼?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="1135.5" width="257.0" height="50.0" as="geometry"/></mxCell><mxCell id="c284" value="E7 두 로봇 goal 취소" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7E4E0;strokeColor=#A33A2B;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="2985.0" y="1147.2" width="173.0" height="26.5" as="geometry"/></mxCell><mxCell id="c287" value="남은 작업·후보 없음?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="1203.5" width="257.0" height="50.0" as="geometry"/></mxCell><mxCell id="c288" value="진행 감시 계속" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2985.0" y="1215.2" width="173.0" height="26.5" as="geometry"/></mxCell><mxCell id="c291" value="S7 두 로봇 DOCK 작업" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="1271.5" width="257.0" height="26.5" as="geometry"/></mxCell><mxCell id="c293" value="S8 network_map_engine 최종 계산 →&lt;br&gt;보고서 · 점검표 → DB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="1316.0" width="257.0" height="41.0" as="geometry"/></mxCell><mxCell id="c295" value="순찰 종료" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5D7C;fontColor=#17202A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2766.5" y="1375.0" width="120.0" height="30.0" as="geometry"/></mxCell><mxCell id="c297" value="Flask 관제 웹 · SQLite  ·  관제 PC · System Monitor" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#2B6A55;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2682.0" y="1443.0" width="488.0" height="228.0" as="geometry"/></mxCell><mxCell id="c298" value="Flask + Socket.IO: 로그인 · 탭 4개 (네트워크 지도 · 작업·로봇 · CAM(로봇 OAK-D) · 점검 이력)&lt;br&gt;버튼: 순찰 시작 · 비상정지 · 재배정 · 보고서" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2696.0" y="1487.0" width="460.0" height="74.0" as="geometry"/></mxCell><mxCell id="c299" value="SQLite: runs · net_samples · grid_stats · baselines · avoid_cells · facilities · candidates · tasks · inspections · alerts" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2696.0" y="1571.0" width="460.0" height="88.0" as="geometry"/></mxCell><mxCell id="c300" value="로봇 B · TurtleBot4 탑재 RPi4 · /robot3&lt;br&gt;로봇 A와 같은 노드·흐름 · Discovery Server (로봇 B) · 이름공간만 /robot3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#8A969F;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="200.0" y="1252.0" width="640.0" height="64.0" as="geometry"/></mxCell><mxCell id="c301" value="PC 3 · 로봇 PC B · MSI GPU 노트북&lt;br&gt;로봇 PC A와 같은 노드·흐름 (Localization·Navigation · detection_alert 포함) · 클라이언트 → 로봇 B 서버" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#8A969F;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120.0" y="3769.5" width="700.0" height="64.0" as="geometry"/></mxCell><mxCell id="c302" value="브라우저 (팀·관리자)&lt;br&gt;HTTP · WebSocket" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9ECEE;strokeColor=#5A6670;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2100.0" y="1711.0" width="1100.0" height="56.0" as="geometry"/></mxCell><mxCell id="c303" value="통신 구간 · 모두 Wi-Fi turtle08  ·  FastDDS · ROS_DOMAIN_ID 동일 · rmw_fastrtps_cpp" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF5F6;strokeColor=#0B7A84;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2100.0" y="1797.0" width="1100.0" height="299.0" as="geometry"/></mxCell><mxCell id="c304" value="① RPi ↔ 로봇 PC (같은 로봇 짝) · IF-02 · 04 · 06 · 07 · 14" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE8F7;strokeColor=#5B4BA6;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2114.0" y="1841.0" width="290.0" height="43.0" as="geometry"/></mxCell><mxCell id="c305" value="가장 바쁜 구간. 센서 ↑ /scan · /odom · /tf, 구동 ↓ /cmd_vel (Localization·Navigation이 여기에 기대요), 측정 raw ↑, 설비&lt;br&gt;점검 때만 OAK-D 영상 ↑, 정밀측정·dock 요청 ↓. 끊기면 주행이 멈추므로 RPi는 5 GHz, 시험 때 지연·제어 주기를 먼저 잽니다." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#CBD3D8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2414.0" y="1841.0" width="772.0" height="43.0" as="geometry"/></mxCell><mxCell id="c306" value="② 로봇 PC ↔ 관제 PC · IF-08–12 · 19" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2114.0" y="1892.0" width="290.0" height="43.0" as="geometry"/></mxCell><mxCell id="c307" value="측정 샘플 ↑ (1 Hz), status ↑ (1 Hz), 설비 판정 결과 ↑, sync · keepout 마스크 · execute_task ↓. 끊겨도 받은 작업은&lt;br&gt;끝까지(설비 판정 포함) — 측정은 버퍼(JSONL)+sync, 판정 결과는 transient_local로 재연결 때 채움 (E4 · D8)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#CBD3D8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2414.0" y="1892.0" width="772.0" height="43.0" as="geometry"/></mxCell><mxCell id="c308" value="③ RPi → 관제 PC 직접 · IF-14" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2114.0" y="1943.0" width="290.0" height="40.0" as="geometry"/></mxCell><mxCell id="c309" value="CAM 탭이 볼 때만 OAK-D 영상을 구독 — 구독자가 없으면 DDS가 보내지 않아요. 맨 위 가로선으로 그렸어요." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#CBD3D8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2414.0" y="1943.0" width="772.0" height="40.0" as="geometry"/></mxCell><mxCell id="c310" value="④ Discovery Server ×3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9ECEE;strokeColor=#5A6670;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2114.0" y="1991.0" width="290.0" height="43.0" as="geometry"/></mxCell><mxCell id="c311" value="로봇 A RPi · 로봇 B RPi · 관제 PC가 서버 (10/08) · 로봇 PC A·B는 각자 자기 로봇 서버의 클라이언트 · 관제 PC 서버가 두 로봇&lt;br&gt;서버와 이어져야 로봇 PC ↔ 관제 PC 토픽이 보임 · CLI는 ROS_SUPER_CLIENT=true." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#CBD3D8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2414.0" y="1991.0" width="772.0" height="43.0" as="geometry"/></mxCell><mxCell id="c312" value="⑤ 핫스팟 · IF-01" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9ECEE;strokeColor=#5A6670;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2114.0" y="2042.0" width="290.0" height="40.0" as="geometry"/></mxCell><mxCell id="c313" value="측정 대상일 뿐 ROS 통신 없음 — RPi가 스캔으로 RSSI만 읽음." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#CBD3D8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2414.0" y="2042.0" width="772.0" height="40.0" as="geometry"/></mxCell><mxCell id="c314" value="Localization · Navigation 한 바퀴  ·  로봇 1대 기준 · 로봇 PC ↔ RPi" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F6F4FB;strokeColor=#5B4BA6;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20.0" y="1350.0" width="820.0" height="178.0" as="geometry"/></mxCell><mxCell id="c315" value="map.yaml&lt;br&gt;map_server → /map" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE8F7;strokeColor=#5B4BA6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="34.0" y="1396.0" width="113.7" height="66.0" as="geometry"/></mxCell><mxCell id="c316" value="RPi 센서&lt;br&gt;/scan · /odom · tf&lt;br&gt;Wi-Fi ↑ IF-07" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF5F6;strokeColor=#0B7A84;fontSize=11;" vertex="1" parent="1"><mxGeometry x="169.7" y="1396.0" width="113.7" height="66.0" as="geometry"/></mxCell><mxCell id="c318" value="amcl&lt;br&gt;tf map→odom&lt;br&gt;/amcl_pose" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE8F7;strokeColor=#5B4BA6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="305.3" y="1396.0" width="113.7" height="66.0" as="geometry"/></mxCell><mxCell id="c320" value="planner&lt;br&gt;global costmap&lt;br&gt;+ keepout (IF-10)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE8F7;strokeColor=#5B4BA6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="441.0" y="1396.0" width="113.7" height="66.0" as="geometry"/></mxCell><mxCell id="c322" value="controller&lt;br&gt;local costmap&lt;br&gt;→ /cmd_vel" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE8F7;strokeColor=#5B4BA6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="576.7" y="1396.0" width="113.7" height="66.0" as="geometry"/></mxCell><mxCell id="c324" value="Create 3&lt;br&gt;Wi-Fi ↓ IF-07&lt;br&gt;바퀴 구동" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF5F6;strokeColor=#0B7A84;fontSize=11;" vertex="1" parent="1"><mxGeometry x="712.3" y="1396.0" width="113.7" height="66.0" as="geometry"/></mxCell><mxCell id="c326" value="goal은 mission_executor가 navigate_through_poses로 넣고, 막히면 behavior_server → 재계획, 계속이면 E1 · 위치가 흐려지면 E5" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#CBD3D8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="34.0" y="1474.0" width="792.0" height="40.0" as="geometry"/></mxCell><mxCell id="c327" value="범례  ·  색 = 모듈 · 선 굵기 = 무선 여부" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#5A6670;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20.0" y="1552.0" width="820.0" height="206.0" as="geometry"/></mxCell><mxCell id="c328s" value="" style="rounded=1;html=1;fillColor=#ECE8F7;strokeColor=#5B4BA6;" vertex="1" parent="1"><mxGeometry x="34.0" y="1602.0" width="28" height="16" as="geometry"/></mxCell><mxCell id="c328" value="Localization · Navigation (Nav2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="74.0" y="1598.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c329s" value="" style="rounded=1;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;" vertex="1" parent="1"><mxGeometry x="298.0" y="1602.0" width="28" height="16" as="geometry"/></mxCell><mxCell id="c329" value="AMR Controller" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="338.0" y="1598.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c330s" value="" style="rounded=1;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;" vertex="1" parent="1"><mxGeometry x="562.0" y="1602.0" width="28" height="16" as="geometry"/></mxCell><mxCell id="c330" value="System Monitor" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="602.0" y="1598.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c331s" value="" style="rounded=1;html=1;fillColor=#F5E9D3;strokeColor=#8E5600;" vertex="1" parent="1"><mxGeometry x="34.0" y="1632.0" width="28" height="16" as="geometry"/></mxCell><mxCell id="c331" value="Detection Alert (물리 인프라)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="74.0" y="1628.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c332s" value="" style="rounded=1;html=1;fillColor=#E9ECEE;strokeColor=#5A6670;" vertex="1" parent="1"><mxGeometry x="298.0" y="1632.0" width="28" height="16" as="geometry"/></mxCell><mxCell id="c332" value="하드웨어 · 외부" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="338.0" y="1628.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c333s" value="" style="rounded=1;html=1;fillColor=#F7E4E0;strokeColor=#A33A2B;dashed=1;" vertex="1" parent="1"><mxGeometry x="562.0" y="1632.0" width="28" height="16" as="geometry"/></mxCell><mxCell id="c333" value="예외 처리 E1–E8" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="602.0" y="1628.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c334s" value="" style="rounded=1;html=1;fillColor=#A8324A;strokeColor=#0B7A84;" vertex="1" parent="1"><mxGeometry x="34.0" y="1662.0" width="28" height="16" as="geometry"/></mxCell><mxCell id="c334" value="Step 1 기기 층 HW·OS·ROS·PKG" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="74.0" y="1658.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c335s" value="" style="rounded=1;html=1;fillColor=#17202A;strokeColor=#0B7A84;" vertex="1" parent="1"><mxGeometry x="298.0" y="1662.0" width="28" height="16" as="geometry"/></mxCell><mxCell id="c335" value="PC 1–3 · ROBOT = 로봇 탑재 RPi" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="338.0" y="1658.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c336s" value="" style="rounded=1;html=1;fillColor=#EAF5F6;strokeColor=#0B7A84;" vertex="1" parent="1"><mxGeometry x="562.0" y="1662.0" width="28" height="16" as="geometry"/></mxCell><mxCell id="c336" value="Wi-Fi 구간 (turtle08)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="602.0" y="1658.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c337s" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#0B7A84;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34.0" y="1700.0" as="sourcePoint"/><mxPoint x="64.0" y="1700.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c337" value="굵은 청록 = Wi-Fi 건넘 (FastDDS)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="74.0" y="1688.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c338s" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#5B4BA6;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="298.0" y="1700.0" as="sourcePoint"/><mxPoint x="328.0" y="1700.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c338" value="굵은 보라 = Wi-Fi 건넘 · 주행 데이터" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="338.0" y="1688.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c339s" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#17202A;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="562.0" y="1700.0" as="sourcePoint"/><mxPoint x="592.0" y="1700.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c339" value="가는 선 = 같은 PC 안" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="602.0" y="1688.0" width="216.0" height="24.0" as="geometry"/></mxCell><mxCell id="c340s" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#0B7A84;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34.0" y="1730.0" as="sourcePoint"/><mxPoint x="64.0" y="1730.0" as="ta