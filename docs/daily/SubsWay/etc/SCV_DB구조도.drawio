rtex="1" parent="rr123"><mxGeometry x="420" y="0" width="300" height="44" as="geometry"><mxRectangle width="300" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc128" value="inspection_manager" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr123"><mxGeometry x="720" y="0" width="230" height="44" as="geometry"><mxRectangle width="230" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc129" value="tasks" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr123"><mxGeometry x="950" y="0" width="150" height="44" as="geometry"><mxRectangle width="150" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc130" value="자동·수동 배정 동시 처리 방지" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr123"><mxGeometry x="1100" y="0" width="420" height="44" as="geometry"><mxRectangle width="420" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rr131" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;top=0;left=0;right=0;bottom=0;html=1;strokeColor=#A33A2B;" vertex="1" parent="rt2"><mxGeometry x="0" y="704" width="1520" height="44" as="geometry"></mxGeometry></mxCell><mxCell id="rc132" value="session:{token}" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Courier New;" vertex="1" parent="rr131"><mxGeometry x="0" y="0" width="200" height="44" as="geometry"><mxRectangle width="200" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc133" value="HASH" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr131"><mxGeometry x="200" y="0" width="110" height="44" as="geometry"><mxRectangle width="110" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc134" value="TTL 8 h" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr131"><mxGeometry x="310" y="0" width="110" height="44" as="geometry"><mxRectangle width="110" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc135" value="api" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr131"><mxGeometry x="420" y="0" width="300" height="44" as="geometry"><mxRectangle width="300" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc136" value="api" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr131"><mxGeometry x="720" y="0" width="230" height="44" as="geometry"><mxRectangle width="230" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc137" value="users" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr131"><mxGeometry x="950" y="0" width="150" height="44" as="geometry"><mxRectangle width="150" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc138" value="server page 로그인 세션" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr131"><mxGeometry x="1100" y="0" width="420" height="44" as="geometry"><mxRectangle width="420" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="x139" value="&lt;b&gt;저장 원칙&lt;/b&gt;&lt;br&gt;• 보고서·KPI·재검증 근거 → PostgreSQL에 반드시 저장. Redis에만 있는 데이터는 만들지 않는다&lt;br&gt;• Redis가 비어도 PostgreSQL과 ROS 토픽(status 1 Hz 등)에서 몇 초 안에 다시 채워진다&lt;br&gt;• 모든 휘발 키에 TTL · maxmemory 256mb · volatile-lru&lt;br&gt;• 포트는 127.0.0.1에만 — 제어 PC나 Wi-Fi 쪽에서는 접속하지 않음" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA7B0;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="908" width="740" height="150" as="geometry"></mxGeometry></mxCell><mxCell id="x140" value="&lt;b&gt;제어 PC에 Redis를 두지 않는 이유&lt;/b&gt;&lt;br&gt;• 알림 5 s(BR-T11)·응답 없음 30 s(SR-11)·비상정지는 지연 전달 불가&lt;br&gt;• 표본 1–2 Hz·status 1 Hz라 줄일 트래픽이 거의 없음 (큰 것은 영상인데 관제로 안 보냄)&lt;br&gt;• 로봇↔관제 전송은 ROS 2 QoS가 이미 담당 — 계층을 하나 더 두면 경로가 둘이 됨&lt;br&gt;• 끊김 대비는 제어 PC의 JSONL 버퍼(survey_buffer)로 충분" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7FBFB;strokeColor=#0B7A84;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="908" width="740" height="150" as="geometry"></mxGeometry></mxCell><mxCell id="x141" value="&lt;b&gt;대표 흐름&lt;/b&gt;&lt;br&gt;server page 순찰 시작·수동 배정 → &lt;b&gt;stream:cmd&lt;/b&gt; → inspection_manager → execute_task&lt;br&gt;{ns}/status → ros-bridge → &lt;b&gt;robot:{rid}:state&lt;/b&gt;(30 s) → api → 화면&lt;br&gt;표본 수신 → &lt;b&gt;live:{run}:cells&lt;/b&gt; 증분 → 히트맵 · 후보·확정 → &lt;b&gt;alerts&lt;/b&gt; → WebSocket&lt;br&gt;client page 정지(LOCAL_ESTOP) → {ns}/events → &lt;b&gt;robot:{rid}:estop&lt;/b&gt; → 배정 차단" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#A33A2B;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1560" y="908" width="740" height="150" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="docker" name="3. Docker 구조도"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value='&lt;b style="font-size:24px"&gt;SCV 운영 DB 구조도 — ③ Docker 구조도 · 기기 배치 · 데이터 경로&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#55626C"&gt;Docker Compose는 관제 PC에만 (project: scv) · 제어 PC는 ROS 노드 + 로컬 백엔드 + JSONL 버퍼 · Redis는 관제 PC에만 · v1.2 (2026-10-10)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1700" height="70" as="geometry"></mxGeometry></mxCell><mxCell id="v2" value="&lt;b&gt;로봇 A · TurtleBot4 RPi4&lt;/b&gt; /robot1&lt;br&gt;turtlebot4 bringup (Create3·LiDAR)&lt;br&gt;&lt;b&gt;rssi_scanner&lt;/b&gt; (핫스팟 RSSI 1–2 Hz)&lt;br&gt;OAK-D Pro (압축 영상 토픽)&lt;br&gt;Discovery Server (로봇 A)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="270" height="130" as="geometry"></mxGeometry></mxCell><mxCell id="v3" value="&lt;b&gt;로봇 B · RPi4&lt;/b&gt; /robot2&lt;br&gt;로봇 A와 같은 구성" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="270" height="70" as="geometry"></mxGeometry></mxCell><mxCell id="f4" value="&lt;b&gt;PC 2 · 제어 PC A (MSI GPU)&lt;/b&gt; — 로봇 A의 확장 · Docker 없음(ROS 노드)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#2F5D7C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="580" height="600" as="geometry"></mxGeometry></mxCell><mxCell id="v5" value="&lt;b&gt;Nav2 · AMCL · keepout 필터&lt;/b&gt;&lt;br&gt;지도 = robot_map_path&lt;br&gt;(해시 확인 · 다르면 LoadMap)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECE8F7;strokeColor=#5B4BA6;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="180" width="250" height="90" as="geometry"></mxGeometry></mxCell><mxCell id="v6" value="&lt;b&gt;mission_executor&lt;/b&gt;&lt;br&gt;execute_task 수행 · 자세 보정&lt;br&gt;{ns}/status 1 Hz · {ns}/events" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="180" width="250" height="90" as="geometry"></mxGeometry></mxCell><mxCell id="v7" value="&lt;b&gt;survey_buffer&lt;/b&gt;&lt;br&gt;RSSI + 같은 시각 AMCL 위치 + seq&lt;br&gt;정지 30 s → 중앙값·IQR" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E7F4F3;strokeColor=#0B7A84;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="290" width="250" height="90" as="geometry"></mxGeometry></mxCell><mxCell id="v8" value="&lt;b&gt;detection_alert (YOLO)&lt;/b&gt;&lt;br&gt;inspect_facility 액션 · 판정&lt;br&gt;사진 저장 → HTTP 업로드" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBF3E4;strokeColor=#8E5600;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="290" width="250" height="90" as="geometry"></mxGeometry></mxCell><mxCell id="v9" value="&lt;b&gt;client page 로컬 백엔드&lt;/b&gt; (FastAPI :8080 · rclpy)&lt;br&gt;카메라 MJPEG (보는 동안만 구독) · YOLO 오버레이&lt;br&gt;이 로봇 정지 → mission_executor (LOCAL_ESTOP)&lt;br&gt;상태 · 버퍼 적체 · 지도 해시 표시" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="400" width="530" height="100" as="geometry"></mxGeometry></mxCell><mxCell id="v10" value="&lt;b&gt;로컬 디스크&lt;/b&gt; /opt/scv&lt;br&gt;maps/ (robot_map_path) · buffer/*.jsonl (끊김 대비) · photos/" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5A6670;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="520" width="530" height="70" as="geometry"></mxGeometry></mxCell><mxCell id="v11" value="&lt;b&gt;client page&lt;/b&gt; — 제어 PC A 브라우저&lt;br&gt;카메라 · 로컬 정지 · 상태" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6A55;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="620" width="530" height="80" as="geometry"></mxGeometry></mxCell><mxCell id="f12" value="&lt;b&gt;PC 3 · 제어 PC B (MSI GPU)&lt;/b&gt; — 제어 PC A와 같은 구성 (/robot2)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#2F5D7C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="800" width="580" height="110" as="geometry"></mxGeometry></mxCell><mxCell id="v13" value="&lt;b&gt;Wi-Fi turtle08&lt;/b&gt;&lt;br&gt;FastDDS&lt;br&gt;Discovery&lt;br&gt;Server ×3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF5F6;strokeColor=#0B7A84;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="950" y="130" width="140" height="780" as="geometry"></mxGeometry></mxCell><mxCell id="f14" value="&lt;b&gt;PC 1 · 관제 PC (Victus)&lt;/b&gt; — Docker Engine · docker compose (project: scv)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#17202A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="130" width="1270" height="780" as="geometry"></mxGeometry></mxCell><mxCell id="v15" value="&lt;b&gt;scv-ros-bridge&lt;/b&gt; (원문 ros_bridge)&lt;br&gt;ROS 2 Jazzy · host 네트워크 · ipc host&lt;br&gt;구독: survey/sample · status · events · inspect/result&lt;br&gt;(robot, seq) 중복 제거 → 1 s 일괄 INSERT&lt;br&gt;재연결 시 survey/sync(from_seq)&lt;br&gt;E8 쓰기 실패 → 메모리 큐·재시도" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1150" y="180" width="320" height="170" as="geometry"></mxGeometry></mxCell><mxCell id="v16" value="&lt;b&gt;scv-api&lt;/b&gt; · FastAPI :8000&lt;br&gt;REST + WebSocket · SQLAlchemy · Alembic&lt;br&gt;사진 업로드 수신 → scv_media&lt;br&gt;명령 → stream:cmd" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1150" y="400" width="320" height="130" as="geometry"></mxGeometry></mxCell><mxCell id="v17" value="&lt;b&gt;scv-web&lt;/b&gt; · nginx :80&lt;br&gt;server page (React 빌드)&lt;br&gt;/api · /ws → scv-api" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1150" y="580" width="320" height="100" as="geometry"></mxGeometry></mxCell><mxCell id="v18" value="&lt;